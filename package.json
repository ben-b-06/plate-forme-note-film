{
  "name": "plate-forme-note-film",
  "version": "1.0.0",
  "private": true,
  "description": "CinéNote : application web (PWA) pour noter films, séries et chaque épisode, avec recommandations, notes des autres plateformes, publicité et abonnement Premium.",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env server/index.js",
    "dev": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env --watch server/index.js",
    "sync": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env scripts/sync.js",
    "seed": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env scripts/seed.js",
    "icons": "node scripts/icons.js",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.js"
  },
  "dependencies": {
    "express": "^5.1.0"
  }
}
