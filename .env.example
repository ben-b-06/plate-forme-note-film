# Copiez ce fichier en « .env » puis complétez. Toutes les variables sont optionnelles.

# --- Général ---
APP_NAME=CinéNote
PORT=3000
# URL publique (obligatoire en production : liens Stripe, cookies sécurisés)
PUBLIC_URL=http://localhost:3000
# NODE_ENV=production
DATABASE_PATH=data/app.db
# E-mails ayant accès à la page /admin (séparés par des virgules)
ADMIN_EMAILS=

# --- Sources de données (notes des plateformes, nouveautés) ---
# TMDB : films + séries en français, tendances, recommandations. Gratuit : https://www.themoviedb.org/settings/api
TMDB_API_KEY=
# OMDb : notes IMDb, Rotten Tomatoes, Metacritic (1 000 requêtes/jour en gratuit) : https://www.omdbapi.com/apikey.aspx
OMDB_API_KEY=
# TVmaze : séries, épisodes et notes, sans clé
TVMAZE_ENABLED=true

# --- Mise à jour automatique de la base ---
SYNC_ENABLED=true
SYNC_INTERVAL_HOURS=6
SYNC_ON_START=true
# Jeton pour déclencher la mise à jour depuis un cron externe : POST /api/cron/sync (Authorization: Bearer <jeton>)
SYNC_SECRET=
# Pays dont on surveille les programmes TV (TVmaze)
SYNC_TVMAZE_COUNTRIES=FR,US

# --- Publicité (Google AdSense) ---
# ADSENSE_CLIENT=ca-pub-0000000000000000
ADSENSE_CLIENT=
ADSENSE_SLOT_BANNER=
ADSENSE_SLOT_INFEED=

# --- Abonnement Premium (Stripe) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
PREMIUM_PRICE_LABEL=2,99 € / mois
# Mode démo (Premium sans paiement) : actif par défaut hors production tant que Stripe n'est pas configuré
# ALLOW_DEMO_PREMIUM=false
